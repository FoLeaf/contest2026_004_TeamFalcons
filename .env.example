# Machine-local overrides (copy to .env.local and customize per computer).
# This file is safe to commit; .env.local is gitignored.
#
# WSL / Linux tools
# CLANGD_BIN=/home/you/tools/clangd/clangd_22.1.6/bin/clangd
# GDB_BIN=/home/you/tools/gdb-multiarch/usr/bin/gdb-multiarch
# GDB_LIBS=/home/you/tools/gdb-multiarch/usr/lib/x86_64-linux-gnu
# OPENVELA_ROOT=/home/you/openvela
#
# Windows tools (WSL interop paths or Win paths for PowerShell)
# OPENVELA_OPENOCD=/mnt/d/Develop/xpack-openocd-0.12.0-7/bin/openocd.exe
# STM32_PROGRAMMER_CLI=D:\Develop\STM32CubeCLT_1.21.0\STM32CubeProgrammer\bin\STM32_Programmer_CLI.exe
# STM32_EXTERNAL_LOADER=D:\Develop\STM32CubeCLT_1.21.0\STM32CubeProgrammer\bin\ExternalLoader\MT25TL01G_STM32H750B-DISCO.stldr
#
# Optional WSL distro name for Windows helper scripts
# OPENVELA_WSL_DISTRO=Debian
