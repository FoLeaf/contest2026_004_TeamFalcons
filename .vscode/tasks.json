{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "openvela: build VelaGuard test QSPI firmware",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_build_openvela.ps1"
      ],
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "openvela: build VelaGuard test debug QSPI firmware",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_build_openvela.ps1",
        "-DebugBuild"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "openvela: build VelaGuard production QSPI firmware",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_build_openvela.ps1",
        "-VelaGuardMode",
        "production"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "openvela: flash VelaGuard test QSPI firmware (CubeProgrammer)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_flash_cube.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "openvela: flash current artifacts only (CubeProgrammer)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_flash_cube.ps1",
        "-NoBuild"
      ],
      "problemMatcher": []
    },
    {
      "label": "openvela: flash VelaGuard test debug firmware (CubeProgrammer)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_flash_cube.ps1",
        "-DebugBuild"
      ],
      "problemMatcher": []
    },
    {
      "label": "openvela: flash VelaGuard production firmware (CubeProgrammer)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_flash_cube.ps1",
        "-VelaGuardMode",
        "production"
      ],
      "problemMatcher": []
    }
  ]
}
