{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "openvela: build QSPI firmware",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_build_openvela.ps1"
      ],
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "openvela: build debug QSPI firmware",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_build_openvela.ps1",
        "-DebugBuild"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "openvela: flash QSPI firmware (CubeProgrammer)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_flash_cube.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "openvela: flash only (CubeProgrammer)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_flash_cube.ps1",
        "-NoBuild"
      ],
      "problemMatcher": []
    },
    {
      "label": "openvela: flash debug firmware (CubeProgrammer)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows_flash_cube.ps1",
        "-DebugBuild"
      ],
      "problemMatcher": []
    }
  ]
}
